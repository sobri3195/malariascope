{
  "name": "malariascope",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:browser": "node scripts/run-browser-acceptance.mjs",
    "test:cross-browser": "node scripts/cross-browser-smoke.mjs",
    "test:performance": "node --experimental-strip-types scripts/performance-benchmark.mjs",
    "test:research": "python -m unittest research.test_pipeline services.test_service services.test_dispatch -v",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"**/node_modules/**\" --test-coverage-lines=70 --test-coverage-branches=55 --test-coverage-functions=70 --test src/*.test.ts",
    "test:accessibility": "node scripts/accessibility-audit.mjs"
  },
  "dependencies": {
    "@turf/turf": "^7.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@types/leaflet": "^1.9.21",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1"
  }
}
