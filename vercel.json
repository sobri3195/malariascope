{
  "rewrites": [{ "source": "/((?!data/|assets/|mobile-sw\\.js).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/mobile-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/mobile" }
      ]
    }
  ]
}
